# ---------------------------------------------------------------------------
# FieldWise — server-only environment variables
#
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# Everything in this file is read ONLY on the server: it is never bundled
# into the browser, never returned in API responses, and never logged.
#
# Rules that keep secrets out of the client:
#   - Never prefix a secret with `VITE_` — any `VITE_*` value is inlined
#     into the public bundle at build time and readable by anyone.
#   - Read these inside server functions / `.server.ts` modules only
#     (see src/lib/config.server.ts and src/lib/api/sentinel.functions.ts).
#   - Provider errors returned to the UI are fixed, non-sensitive messages;
#     raw provider response bodies and tokens are never surfaced or logged.
# ---------------------------------------------------------------------------

# Copernicus Data Space Ecosystem (CDSE) OAuth client for the Sentinel-2
# observation slice (search + NDVI preview/statistics).
#
# How to obtain (official CDSE Dashboard):
#   1. Register / sign in at https://dashboard.dataspace.copernicus.eu/
#   2. User Settings → OAuth clients → create a client of type
#      "Authorisation with client credentials" (or the recommended default).
#   3. Copy the client id and secret shown there.
#
# Notes:
#   - Access tokens are minted from these credentials and cached server-side
#     until close to expiry (~1 h lifetime); token requests are rate-limited
#     by the provider, so do not rotate these values per request.
#   - Without these values the dashboard shows a setup message instead of
#     fake imagery — nothing is fetched and no scenes are listed.
#   - Usage is subject to the Copernicus Data Space Ecosystem Terms of Use
#     and Sentinel Hub attribution requirements; the UI displays the
#     required attribution with every observation.
CDSE_OAUTH_CLIENT_ID=
CDSE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# ERA5-Land historical weather (Copernicus Climate Data Store)
# The adapter requests the dataset `reanalysis-era5-land` through the store's
# REST API and decodes the result, but it only runs when these values are
# present: without them the product shows a setup state and no value is
# fabricated. To obtain a key: register at https://cds.climate.copernicus.eu/,
# open the API section of your profile and copy the personal access token.
# ---------------------------------------------------------------------------
# CDS API base. The current store serves the retrieval API under /api
# (the older /api/v2 path answers 404).
CDS_API_URL=https://cds.climate.copernicus.eu/api
# Personal access token for the API. Use only in server-side code.
CDS_API_KEY=your_cds_personal_access_token
